* {
  box-sizing: border-box;
}

:root {
  --bg: #f5f7fb;
  --panel: #ffffff;
  --panel-alt: #edf3ff;
  --primary: #113c8c;
  --primary-light: #eaf0ff;
  --secondary: #1f9d8b;
  --accent: #f6b73c;
  --text: #1d2a39;
  --muted: #5e6a7a;
  --line: #dfe7f5;
  --shadow: 0 18px 45px rgba(17, 60, 140, 0.12);
  --success: #1d9d72;
  --danger: #d94b4b;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Cairo", sans-serif;
  background: linear-gradient(180deg, #eef5ff 0%, #f7f9fd 100%);
  color: var(--text);
}

body[dir="rtl"] {
  direction: rtl;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select {
  font: inherit;
}

.container {
  width: min(1150px, calc(100% - 32px));
  margin: 0 auto;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88px;
  gap: 20px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 16px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--primary), #2b6df4);
  color: white;
  font-weight: 800;
  font-size: 1.7rem;
}

.eyebrow,
.section-tag,
.mini-label {
  margin: 0;
  color: var(--primary);
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 0.74rem;
}

.brand-wrap h1 {
  margin: 0;
  font-size: clamp(1.2rem, 2vw, 1.6rem);
}

.main-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  color: var(--muted);
  font-weight: 600;
}

.main-nav a:hover {
  color: var(--primary);
}

.hero {
  padding: 64px 0 32px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.6fr 0.9fr;
  gap: 28px;
  align-items: center;
}

.hero-copy h2 {
  margin: 12px 0 18px;
  font-size: clamp(2.1rem, 4vw, 4rem);
  line-height: 1.15;
}

.hero-copy p {
  color: var(--muted);
  line-height: 1.9;
  font-size: 1.06rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
}

.primary-btn,
.secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 22px;
  border-radius: 12px;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--primary), #2f77f4);
  color: white;
  box-shadow: var(--shadow);
}

.secondary-btn {
  border: 1px solid var(--line);
  background: white;
  color: var(--text);
}

.primary-btn:hover,
.secondary-btn:hover,
button:hover {
  transform: translateY(-1px);
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 16px;
  margin-top: 28px;
}

.stat-box {
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  text-align: center;
}

.stat-box strong {
  font-size: clamp(1.3rem, 2vw, 2rem);
  color: var(--primary);
}

.stat-box span {
  color: var(--muted);
}

.hero-panel {
  display: flex;
  justify-content: center;
}

.panel-card {
  width: min(100%, 430px);
  background: linear-gradient(180deg, #111d40, #1a2c5a);
  color: white;
  border-radius: 26px;
  padding: 28px 24px;
  box-shadow: var(--shadow);
}

.panel-card ul {
  margin: 18px 0 0;
  padding-right: 20px;
  line-height: 2.2;
  color: rgba(255, 255, 255, 0.8);
}

.controls {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 18px;
  margin-top: 20px;
  margin-bottom: 14px;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.filter-group label {
  font-weight: 700;
  color: var(--text);
}

.filter-group select,
.filter-group input,
.planner-box input,
.planner-box select {
  border: 1px solid var(--line);
  background: white;
  border-radius: 12px;
  min-height: 52px;
  padding: 0 16px;
  color: var(--text);
  outline: none;
}

.filter-group input:focus,
.filter-group select:focus,
.planner-box input:focus,
.planner-box select:focus {
  border-color: rgba(17, 60, 140, 0.45);
  box-shadow: 0 0 0 4px rgba(17, 60, 140, 0.08);
}

.content-section {
  padding: 28px 0 12px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 18px;
}

.section-heading h3 {
  margin: 8px 0 0;
  font-size: clamp(1.6rem, 2vw, 2.3rem);
}

.subject-grid,
.exam-grid,
.resource-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  gap: 22px;
}

.subject-card,
.exam-card,
.resource-item,
.dashboard-tile,
.study-plan-box {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: 0 12px 26px rgba(17, 60, 140, 0.05);
}

.subject-card {
  padding: 22px 18px;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

.subject-stream {
  display: inline-flex;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 0.8rem;
  font-weight: 700;
}

.subject-pill {
  color: var(--secondary);
  background: rgba(31, 157, 139, 0.1);
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 0.75rem;
  font-weight: 700;
}

.subject-title {
  margin: 0;
  font-size: 1.45rem;
}

.subject-description {
  color: var(--muted);
  line-height: 1.8;
  margin: 14px 0 12px;
}

.source-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}

.source-badge {
  display: inline-block;
  background: #f4f7ff;
  color: var(--primary);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 5px 10px;
  font-size: 0.75rem;
  font-weight: 700;
}

.objective-box {
  margin-top: 12px;
}

.objective-box h5 {
  margin: 0 0 10px;
  color: var(--primary);
  font-size: 0.96rem;
}

.focus-list {
  margin: 0;
  padding-right: 18px;
  color: var(--text);
  line-height: 1.8;
}

.unit-preview {
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid var(--line);
}

.unit-preview h5 {
  margin: 0 0 10px;
  color: var(--primary);
  font-size: 0.96rem;
}

.unit-preview ul {
  margin: 0;
  padding-right: 18px;
  line-height: 1.8;
  color: var(--muted);
}

.exam-card {
  padding: 20px 18px;
}

.exam-card h4 {
  margin: 0 0 8px;
  font-size: 1.3rem;
}

.exam-card p {
  margin: 0 0 14px;
  color: var(--muted);
  line-height: 1.7;
}

.exam-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 15px;
}

.pill {
  display: inline-flex;
  background: #eefaf5;
  color: var(--success);
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.75rem;
  font-weight: 700;
}

.exam-card button,
.submit-btn,
.retry-btn {
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), #2f77f4);
  color: white;
  min-height: 44px;
  padding: 0 18px;
  font-weight: 700;
  cursor: pointer;
}

.exam-runner {
  background: white;
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: 0 12px 24px rgba(17, 60, 140, 0.05);
  padding: 24px;
  margin-top: 18px;
}

.hidden {
  display: none;
}

.question-block {
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}

.question-block:last-child {
  border-bottom: none;
}

.question-block h4 {
  margin: 0 0 12px;
  font-size: 1.1rem;
}

.option-list {
  display: grid;
  gap: 10px;
}

.option-row {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #f7f9ff;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 10px 12px;
}

.option-row input {
  accent-color: var(--primary);
}

.exam-result {
  margin-top: 18px;
  background: #f3fbf7;
  border: 1px solid #bfe6d3;
  color: #1e6f56;
  border-radius: 14px;
  padding: 14px 16px;
  font-weight: 700;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 18px;
}

.dashboard-tile {
  padding: 22px 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.tile-label {
  color: var(--muted);
  font-weight: 600;
}

.dashboard-tile strong {
  font-size: 2rem;
  color: var(--primary);
}

.study-plan-box {
  margin-top: 22px;
  padding: 22px 18px;
}

.study-plan-box h4 {
  margin: 0 0 12px;
  font-size: 1.35rem;
}

.study-plan {
  margin: 0;
  padding-right: 18px;
  line-height: 2;
  color: var(--muted);
}

.resource-item {
  padding: 18px 16px;
}

.resource-item h4 {
  margin: 0 0 8px;
  color: var(--primary);
}

.resource-item p {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.empty-state {
  background: #fff7ea;
  border: 1px solid #f4d8a5;
  color: #8e5f00;
  border-radius: 14px;
  padding: 18px 20px;
}

@media (max-width: 900px) {
  .hero-grid,
  .controls {
    grid-template-columns: 1fr;
  }

  .main-nav {
    display: none;
  }
}

@media (max-width: 600px) {
  .hero {
    padding-top: 42px;
  }

  .stats-row {
    grid-template-columns: 1fr;
  }

  .brand-wrap {
    gap: 10px;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
  }
}
